[Unit]
Description=Python Blinds Service
After=network.target

[Service]
Type=idle
Restart=on-failure
User=root
WorkingDirectory=/home/mazelpico/workspace/python-blinds
ExecStart=/usr/bin/env uv run --project /home/mazelpico/workspace/python-blinds/blinds --locked --no-dev -m blinds

[Install]
WantedBy=multi-user.target